# Core app
AUTH_SECRET=replace-with-a-random-32-byte-secret
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/lifeos
MONGODB_DB_NAME=lifeos

# AI provider
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
# Used only by server-side AI routes.
OPENAI_API_KEY=replace-with-your-openai-key

# Optional Google Gemini provider. Set AI_PROVIDER=google to use it.
GOOGLE_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
